# cmake -DOUT=file.cpp -DINPUTS="a.bin|b.bin|..." -P embed_cunny.cmake
#
# Writes the CuNNy weight files (tools/cunny_convert.py) into a C++ source,
# one byte array per model in the order given, behind th2::cunny_weights().
# Embedded rather than shipped next to the binary so the web build needs no
# preload and the weights cannot go missing from an install.
set(body "// Generated by cmake/embed_cunny.cmake - do not edit.\n")
string(APPEND body "#include \"cunny_weights.hpp\"\n\nnamespace th2 {\nnamespace {\n\n")
string(REPLACE "|" ";" INPUTS "${INPUTS}")
set(index 0)
set(cases "")
foreach(input IN LISTS INPUTS)
    file(READ "${input}" hex HEX)
    string(LENGTH "${hex}" length)
    math(EXPR size "${length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # Line breaks every 32 bytes so the source stays readable by tools.
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" bytes "${bytes}")
    get_filename_component(name "${input}" NAME)
    string(APPEND body "// ${name}\nalignas(4) const unsigned char model${index}[${size}] = {\n${bytes}\n};\n\n")
    string(APPEND cases "    case ${index}: return {model${index}, sizeof(model${index})};\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND body "}  // namespace\n\n")
string(APPEND body "std::span<const unsigned char> cunny_weights(CunnyModel model)\n{\n")
string(APPEND body "    switch (static_cast<int>(model)) {\n${cases}    }\n    return {};\n}\n\n}  // namespace th2\n")
file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
